# Mozilla Add-ons API Credentials
# Get these from: https://addons.mozilla.org/developers/addon/api/key/

# JWT Issuer (API Key)
WEB_EXT_API_KEY=your_jwt_key_here

# JWT Secret (API Secret)  
WEB_EXT_API_SECRET=your_jwt_secret_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values above with your actual JWT credentials
# 3. Run: web-ext sign
# The CLI will automatically read credentials from .env file
